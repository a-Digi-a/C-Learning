  #gdPlayPause { min-width:64px; background-color:#404040; color:#d0d0d0; border:1px solid #707070; border-radius:4px; padding:4px 10px; }
  #gdSlider { flex:1; appearance:none; -webkit-appearance:none; background:transparent; }
  #gdSlider::-webkit-slider-runnable-track { height:6px; background:#707070; border-radius:3px; }
  #gdSlider::-webkit-slider-thumb { -webkit-appearance:none; width:14px; height:14px; margin-top:-4px; background:#909090; border:1px solid #505050; border-radius:50%; }
